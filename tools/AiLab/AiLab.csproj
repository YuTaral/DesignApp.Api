<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A developer tool, not part of the solution: runs the real AI pipeline on one photo and records
    every Claude and SAM 3 answer (record), then replays them for free while the mask picking and
    label-map cleanup are tuned (replay). Usage is in Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UserSecretsId>e485a9f7-2eeb-41a4-af96-3a5bcadfefb5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesignApp.Infrastructure\DesignApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
