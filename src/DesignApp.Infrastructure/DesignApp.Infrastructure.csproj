<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DesignApp.Application\DesignApp.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.4.0" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesignApp.UnitTests" />
    <InternalsVisibleTo Include="DesignApp.IntegrationTests" />
    <InternalsVisibleTo Include="AiLab" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-traced analyses of the sample room photos, used by the fake AI providers. -->
    <EmbeddedResource Include="Ai\Fakes\Samples\*.json" />
    <!-- Visual Studio's quick up-to-date check otherwise misses sample files added or edited outside it. -->
    <UpToDateCheckInput Include="Ai\Fakes\Samples\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The built-in library: ready-made designs analyzed ahead of time (photo, label map and objects per room). -->
    <EmbeddedResource Include="Library\**\*.json;Library\**\*.jpg;Library\**\*.png" Exclude="Library\Objects\**" LogicalName="DesignApp.Library/%(RecursiveDir)%(Filename)%(Extension)" />
    <UpToDateCheckInput Include="Library\**\*.json;Library\**\*.jpg;Library\**\*.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
